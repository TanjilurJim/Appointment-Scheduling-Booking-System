
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2>Welcome Admin</h2>
    <p class="text-muted">
        Manage appointment requests and system activities.
    </p>

    <h4 class="mt-4">Appointment Requests</h4>

    <div class="table-responsive mt-3">
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Request ID</th>
                    <th>Customer</th>
                    <th>Consultant</th>
                    <th>Appointment Date</th>
                    <th>Time</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="7" class="text-center text-muted">
                        Appointment requests will appear here.
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
