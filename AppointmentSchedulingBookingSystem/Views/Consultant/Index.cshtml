@model AppointmentSchedulingBookingSystem.ViewModels.ConsultantWeekViewModel
@{
    ViewData["Title"] = "Consultant Dashboard";
}

<div class="container mt-4">
    <h2>Welcome Consultant</h2>
    <p class="text-muted">Manage your availability and appointments.</p>

    <div class="card mt-4">
        <div class="card-body">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                <div>
                    <h3 class="h5 mb-1">My Schedule This Week</h3>
                    <p class="text-muted mb-0">
                        @Model.WeekStart.ToString("dd MMM yyyy") - @Model.WeekStart.AddDays(6).ToString("dd MMM yyyy")
                        <span class="d-block small">Monday to Sunday · Bangladesh time</span>
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a asp-action="Schedule" class="btn btn-primary">Update Schedule</a>
                    <a asp-action="Breaks" class="btn btn-outline-primary">Manage Breaks</a>
                </div>
            </div>

            @if (!Model.HasProfile)
            {
                <div class="alert alert-info mb-0">
                    Your consultant profile has not been set up yet. Ask an administrator to complete your profile before configuring your schedule.
                </div>
            }
            else
            {
                <p class="small text-muted">Appointment duration: @Model.SlotDurationMinutes minutes</p>
                @if (Model.Days.All(d => !d.StartTime.HasValue))
                {
                    <div class="alert alert-info">No working hours configured. Select Update Schedule to add your availability.</div>
                }
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <caption class="visually-hidden">This week's working hours and scheduled breaks</caption>
                        <thead>
                            <tr><th scope="col">Day / Date</th><th scope="col">Working Hours</th><th scope="col">Breaks</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var day in Model.Days)
                            {
                                <tr class="@(day.Date == Model.Today ? "table-primary" : "")">
                                    <th scope="row">
                                        @day.Date.DayOfWeek
                                        @if (day.Date == Model.Today)
                                        {
                                            <span class="badge bg-primary ms-1">Today</span>
                                        }
                                        <span class="d-block small fw-normal">@day.Date.ToString("dd MMM yyyy")</span>
                                    </th>
                                    <td>
                                        @if (day.StartTime.HasValue)
                                        {
                                            <span>@day.StartTime.Value.ToString("HH:mm") - @day.EndTime?.ToString("HH:mm")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Not working</span>
                                        }
                                    </td>
                                    <td>
                                        @if (day.Breaks.Count == 0)
                                        {
                                            <span class="text-muted">@(day.StartTime.HasValue ? "No breaks" : "—")</span>
                                        }
                                        else
                                        {
                                            <ul class="list-unstyled mb-0">
                                                @foreach (var pause in day.Breaks)
                                                {
                                                    <li>
                                                        @pause.StartTime.ToString("HH:mm") - @pause.EndTime.ToString("HH:mm")
                                                        <span class="badge bg-secondary">@(pause.Date.HasValue ? "One-time" : "Weekly")</span>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
